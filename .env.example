APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# Hostinger: always load DB_* and secrets from .env (never stale bootstrap/cache/config.php)
READ_ENV_FROM_DOTENV=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite

# Hostinger MySQL (hPanel → Databases → copy exact names; user MUST be linked to the database)
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=u123456789_pelvicare
# DB_USERNAME=u123456789_pelvicare
# DB_PASSWORD="your-password-from-hpanel"
# Username/database prefix (u123456789) must be from the SAME account as this website.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Hostinger (hPanel, no SSH terminal) ---
# 1) On your PC run:  .\scripts\deploy-hostinger.ps1
# 2) Upload project to public_html (include vendor/ and public/build/). Do NOT upload bootstrap/cache/*.php from Windows.
# 3) hPanel → Domains → document root: public_html/public
# 4) Create .env on server: APP_ENV=production, APP_DEBUG=false, APP_URL=https://your-domain.com, DB_* , APP_KEY=...
# 5) Set a long random token, then visit once in the browser:
DEPLOY_TOKEN=
#    https://your-domain.com/deploy/run?token=PASTE_SAME_TOKEN
# 6) Clear DEPLOY_TOKEN from .env after success (or change it).
#
# Optional local-only: legacy uploads in a sibling public_html/ folder while serving from public/
# LEGACY_PUBLIC_DIR=public_html
